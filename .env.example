# Les clés sont facultatives en local : sans elles, la rédaction locale fonctionne.
# Pour les appels IA, Gemini est essayé d'abord, puis DeepSeek, puis OpenAI.
# Garde les clés privées ; ne les publie jamais dans GitHub.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Optionnel : pour un serveur DeepSeek compatible OpenAI autohébergé.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
OPENAI_API_KEY=
# Optionnel : activer les comptes et les travaux partagés en ligne.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Le modèle que tu as déjà réussi à utiliser. Modifiable si Google ne le propose plus à ton compte.
GEMINI_MODEL=gemini-3.6-flash
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini
