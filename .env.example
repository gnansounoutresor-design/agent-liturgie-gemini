# La génération exige au moins une clé fournisseur. Aucun brouillon IA local n'est substitué.
# Ordre d'essai : Gemini, puis DeepSeek, puis OpenAI.
# Garde les clés privées ; ne les publie jamais dans GitHub.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Optionnel : pour un serveur DeepSeek compatible OpenAI autohébergé.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
OPENAI_API_KEY=
# Supabase Auth et bibliothèque partagée.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé très privilégiée : uniquement côté serveur Render, jamais dans le navigateur ou Git.
# Nécessaire pour la suppression autonome d'un compte.
SUPABASE_SERVICE_ROLE_KEY=
# Facultatif : sinon l'application redirige les confirmations vers l'origine de la requête.
SUPABASE_AUTH_REDIRECT_URL=https://priereuniversellebakhita.onrender.com/
# Le modèle que tu as déjà réussi à utiliser. Modifiable si Google ne le propose plus à ton compte.
GEMINI_MODEL=gemini-3.6-flash
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini
